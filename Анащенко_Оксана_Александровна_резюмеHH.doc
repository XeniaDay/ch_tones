\pard\intbl\itap1\sb250\sl280{\fs24\b
"\uc0\u1063 \uc0\u1090 \uc0\u1086  \uc0\u1076 \uc0\u1077 \uc0\u1083 \uc0\u1072 \uc0\u1090 \uc0\u1100  \uc0\u1050 \uc0\u1086 \uc0\u1085 \uc0\u1089 \uc0\u1072 \uc0\u1083 \uc0\u1090 ?"
